[Unit]
Description=Media Analyzer Flask Backend
After=network.target

[Service]
User=${SERVICE_USER}
WorkingDirectory=${BACKEND_DIR}
ExecStart="${BACKEND_DIR}/venv/bin/gunicorn" --bind 127.0.0.1:${BACKEND_PORT} --workers 1 --threads 4 --timeout 300 app:app
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
